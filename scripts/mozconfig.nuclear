# ==============================================================================
# CRUSH SOVEREIGN BROWSER - NUCLEAR DEBLOAT COMPILE SPECIFICATION
# Target: Windows x64 Native C++/Rust Build via GitHub Actions
# ==============================================================================

# 1. Native Binary Identity & Branding
ac_add_options --with-app-name=crush
ac_add_options --with-app-basename=Crush

# 2. Permanent Removal of Mozilla Corporate Telemetry & Surveillance
export MOZ_TELEMETRY_REPORTING=0
ac_add_options --disable-telemetry
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --disable-maintenance-service
ac_add_options --disable-default-browser-agent
ac_add_options --disable-parental-controls
ac_add_options --disable-geckodriver

# 3. Rip Out Heavy Unused Subsystems (Saves ~400MB RAM & Compile Time)
ac_add_options --disable-accessibility
ac_add_options --disable-synth-speech
ac_add_options --disable-webspeech
ac_add_options --disable-gamepad
ac_add_options --disable-tests
ac_add_options --disable-debug

# 4. Maximum Speed & Hardware GPU Acceleration
ac_add_options --enable-optimize="-O3"
ac_add_options --enable-lto=thin
ac_add_options --enable-rust-simd
ac_add_options --enable-wasm-simd
ac_add_options --enable-webrender
ac_add_options --enable-release
ac_add_options --enable-strip

# 5. Compiler Cache
ac_add_options --with-ccache=sccache

# 6. Target Output Directory
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/objdir-crush-nuclear
